; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Multiplayer-Base"
run/main_scene="uid://d2yrx0eq5vatf"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Global="*uid://dh6okxofepb8l"
MultiplayerManager="*uid://dps2a5kcnfxce"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Multiplayer-Base"

[editor_plugins]

enabled=PackedStringArray("res://addons/MP4Player/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "orange",
"res://Resources/": "yellow",
"res://Scenes/": "red",
"res://Scripts/": "blue"
}

[global_group]

Players="Group used for only players"

